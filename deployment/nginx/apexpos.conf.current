server {
    listen 80;
    server_name pos.apexpos.cloud api.apexpos.cloud backoffice.apexpos.cloud;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name api.apexpos.cloud;

    ssl_certificate /etc/letsencrypt/live/api.apexpos.cloud/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.apexpos.cloud/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl;
    server_name pos.apexpos.cloud;

    ssl_certificate /etc/letsencrypt/live/pos.apexpos.cloud/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pos.apexpos.cloud/privkey.pem;

    root /var/www/apexretail-pos;
    index index.html;

    location / {
        try_files $uri /index.html;
    }
}

server {
    listen 443 ssl;
    server_name backoffice.apexpos.cloud;

    ssl_certificate /etc/letsencrypt/live/backoffice.apexpos.cloud/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/backoffice.apexpos.cloud/privkey.pem;

    root /var/www/apexpos-backoffice;
    index index.html;

    location / {
        try_files $uri /index.html;
    }
}
