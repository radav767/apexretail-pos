{
  "name": "pos-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-production.mjs",
    "test:entitlement": "node scripts/run-entitlement-tests.mjs && node --test tests/entitlementUi.test.mjs",
    "test:sales-history": "node scripts/run-sales-history-tests.mjs",
    "test:device-identity": "node scripts/run-device-identity-tests.mjs && node --test tests/sessionUi.test.mjs",
    "test:credit-sale": "node scripts/run-credit-sale-tests.mjs && node --test tests/creditCheckoutUi.test.mjs",
    "test:financial-modules": "node --test tests/financialModulesUi.test.mjs",
    "test:barcode": "node scripts/run-barcode-tests.mjs",
    "test:registration": "node --test tests/registrationCurrencyUi.test.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:discounts": "node scripts/run-discount-tests.mjs && node scripts/run-receipt-discount-tests.mjs && node scripts/test-offline-discounts.mjs && node --test tests/checkoutUi.test.mjs",
    "test:offline-quarantine": "node scripts/test-offline-quarantine.mjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.3",
    "@capacitor/android": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@capacitor/network": "^7.0.4",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "barcode-detector": "3.2.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3",
    "zxing-wasm": "3.1.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
