{
  "name": "backoffice",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test:redirect-security": "node --test tests/redirectSecurity.test.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:dashboard": "node scripts/run-dashboard-tests.mjs && node --test tests/navigation.test.mjs",
    "test:platform-entry": "node --test tests/platformEntry.test.mjs",
    "test:customers": "node --test tests/customers.test.mjs tests/navigation.test.mjs",
    "test:credit-settlements": "node scripts/run-credit-settlement-tests.mjs && node --test tests/creditSettlementsUi.test.mjs tests/navigation.test.mjs",
    "test:expenses": "node scripts/run-expense-tests.mjs && node --test tests/expensesUi.test.mjs tests/navigation.test.mjs",
    "test:financial-reports": "node --test tests/financialReportsUi.test.mjs",
    "test:currencies": "node scripts/run-currency-tests.mjs && node --test tests/currenciesUi.test.mjs tests/navigation.test.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "8.1.6"
  }
}
