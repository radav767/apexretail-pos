# PROPOSAL ONLY. Not installed. Requires separately approved Phase 10 backend,
# reviewed full pending migrations, provisioned MFA key, and dedicated certificate.
# Install as a NEW vhost only; never replace existing site files.
# Serve the EXISTING Backoffice build (base=/), not a second application.
# Enable only after its matching approved Phase 10 build is published here.
server {
    listen 80;
    server_name admin.apexpos.cloud;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/apexretail-acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 301 https://admin.apexpos.cloud$request_uri; }
}

server {
    listen 443 ssl;
    server_name admin.apexpos.cloud;
    ssl_certificate /etc/letsencrypt/live/admin.apexpos.cloud/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.apexpos.cloud/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;

    root /var/www/apexpos-backoffice;
    index index.html;
    client_max_body_size 64k;
    access_log off;
    error_log /var/log/nginx/apexretail-admin-error.log warn;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Cache-Control no-store always;

    location ^~ /api/platform/ {
        # No URI suffix on proxy_pass: retain /api/platform/... exactly.
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_cache off;
        proxy_no_cache 1;
        proxy_next_upstream off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        # Never log credentials, authorization challenges or query strings.
        access_log off;
        error_log /dev/null crit;
    }
    location = /api { return 404; }
    location /api/ { return 404; }
    location ~ /\. { return 404; }
    location ~* \.(?:map|env|pem|key|sql|dump|apk)$ { return 404; }
    location /assets/ { try_files $uri =404; }
    location / { try_files $uri $uri/ /index.html; }
}
